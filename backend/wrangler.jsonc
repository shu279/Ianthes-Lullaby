{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ianthe-chat-api",
  "main": "chat.mjs",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash-lite",
    "ALLOWED_ORIGINS": "https://shu279.github.io,http://localhost:3000,http://127.0.0.1:3000",
    "ENABLE_RAG": "true"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "2791001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
